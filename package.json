{
  "name": "heirloom-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quantum Dead Man's Vault: a post-quantum heartbeat inheritance vault for QoreChain (Build Before Q-Day).",
  "license": "MIT",
  "author": "Andrew Garretson",
  "keywords": ["qorechain", "post-quantum", "ml-dsa-87", "fips-204", "inheritance", "dead-mans-switch", "solidity", "hardhat"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:sim": "vitest run --dir sim",
    "app:dev": "vite --config app/vite.config.ts",
    "app:build": "vite build --config app/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "app:test": "vitest run --config app/vitest.config.ts",
    "app:typecheck": "tsc --noEmit -p app/tsconfig.json",
    "window": "tsx scripts/window.ts",
    "probe": "tsx scripts/probe-pqc.ts",
    "deploy:testnet": "tsx scripts/deploy.ts",
    "drill:setup": "tsx scripts/drill/setup.ts",
    "drill:proof": "tsx scripts/drill/proof-tx.ts",
    "drill:verify": "tsx scripts/drill/verify.ts",
    "keeper": "tsx scripts/keeper.ts",
    "test:scripts": "vitest run --dir scripts",
    "typecheck:scripts": "tsc --noEmit -p scripts"
  },
  "devDependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/statemanager": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.5",
    "@openzeppelin/contracts": "^5.1.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/pqc": "^0.2.3",
    "@qorechain/sdk": "^0.14.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "happy-dom": "21.0.4",
    "hardhat": "^3.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "solc": "0.8.28",
    "tsx": "4.23.15",
    "typescript": "^5.6.3",
    "viem": "^2.47.6",
    "vite": "6.4.6",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.2.4"
